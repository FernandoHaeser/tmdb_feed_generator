# TMDB credentials: either the "API Read Access Token" (v4, recommended) or the 32-character v3 API key.
# Create one at https://www.themoviedb.org/settings/api
TMDB_TOKEN=

# Hours between refreshes of the feed.
FEED_INTERVAL_HOURS=6

# Host port for the web container (point the internal proxy here).
FEED_PORT=8080
